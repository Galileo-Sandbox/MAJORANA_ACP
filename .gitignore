# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Local data, checkpoints, logs (anchored to repo root so they don't
# match similarly named subpackages, e.g. majorana_acp/data/).
/data/
/checkpoints/
/runs/
/analysis/
/wandb/
/mlruns/
/lightning_logs/

# Trained artifacts under results/ stay gitignored (cnp.ckpt etc.
# are large binaries), but we *track* run_summary.json — it's the
# lightweight per-experiment fingerprint and our git-visible
# experiment registry. The three-line idiom below is required
# because git won't re-include a file under a fully-ignored parent
# directory: we ignore every path at every depth, then re-allow
# subdirectories so git descends, then re-allow the specific JSON.
results/**
!results/**/
!results/**/run_summary.json

# OS / editor
.DS_Store
.vscode/
.idea/

# Local Claude Code state (settings.local.json, scheduled_tasks.lock).
/.claude/
